# Copy to .env and change the values before the first start:
#   cp .env.example .env && docker compose up -d --build
# MariaDB and MinIO keep the credentials they were first started with (stored in their volumes);
# changing a value here later does not change it there.
# Use letters, digits, - and _ only: the MariaDB password is also part of the backend's database URL.

# MariaDB
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=glacier
MARIADB_USER=glacier
MARIADB_PASSWORD=change-me-db
MARIADB_REPLICATION_USER=replicator
MARIADB_REPLICATION_PASSWORD=change-me-replication
# Read-only user for the Prometheus MariaDB exporters
MARIADB_EXPORTER_PASSWORD=change-me-exporter

# MinIO (uploads); the backend uses these as its S3 keys
MINIO_ROOT_USER=glacier
MINIO_ROOT_PASSWORD=change-me-minio

# Grafana login (http://localhost:3001)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Docker Hub: where `docker compose push backend nginx` publishes the two Glacier images
DOCKERHUB_USER=akmalfairuz
GLACIER_VERSION=latest
